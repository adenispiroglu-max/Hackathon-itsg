# Documentation only: export these in the process environment.
# Never commit a real credential.
HAI_API_KEY=
AUDITFLOW_MODEL_PROVIDER=hessian
# Per-socket connect/read timeout; not a document-wide completion deadline (10–300 seconds).
AUDITFLOW_MODEL_TIMEOUT=120
# Hessian output budget (512–32768); provider/model limits still apply. Gemini keeps its own 8192.
AUDITFLOW_MODEL_MAX_TOKENS=8192
AUDITFLOW_MODEL=vllm/GLM-Flash:Latest
AUDITFLOW_MODEL_URL=https://hip-gw.hessian.ai/v1/chat/completions
# Native Google Gemini alternative (set in the server process, not in the browser):
# AUDITFLOW_MODEL_PROVIDER=gemini
# GEMINI_API_KEY=
# AUDITFLOW_MODEL=gemini-flash-latest
# Gemini ignores AUDITFLOW_MODEL_URL and only uses the official Google API host.
# Optional: choose another persistent DB file.
# AUDITFLOW_DB=var/auditflow.sqlite3
# Required for network binding; entered in UI via Zugang.
# AUDITFLOW_ACCESS_TOKEN=
# Optional customer package delivery, TLS is mandatory (starttls or ssl).
# AUDITFLOW_SMTP_HOST=smtp.example.invalid
# AUDITFLOW_SMTP_PORT=587
# AUDITFLOW_SMTP_TLS=starttls
# AUDITFLOW_MAIL_FROM=audit@example.invalid
# AUDITFLOW_SMTP_USER=
# AUDITFLOW_SMTP_PASSWORD=
